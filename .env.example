# Rail Safety Chatbot — Environment Variables
# Copy this file to .env and fill in your values

# Your Anthropic API key from https://console.anthropic.com
# Leave blank to run in demo mode (shows retrieved excerpts only, no Claude synthesis)
ANTHROPIC_API_KEY=

# Optional: override the default model
# Default: claude-opus-4-8
# MODEL=claude-opus-4-8

# Optional: override the number of top retrieved excerpts
# Default: 6
# TOP_K=6
