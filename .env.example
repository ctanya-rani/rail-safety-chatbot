# Rail Safety Chatbot — environment variables
#
# Nothing in this project auto-loads a .env file, so either export these in
# your shell or paste them into your host's variables UI:
#
#     export $(grep -v '^#' .env | xargs)
#
# Every variable is optional. With no API key the server runs in demo mode.

# Anthropic API key, from https://console.anthropic.com
# Leave unset to run in demo mode (retrieval works; answers are the raw excerpts).
ANTHROPIC_API_KEY=

# Override the model used for synthesis. Default: claude-opus-4-8
# RAILSAFE_MODEL=claude-opus-4-8

# Excerpts retrieved per question. Default: 6
# RAILSAFE_TOP_K=6

# Max tokens per answer. Default: 16000
# RAILSAFE_MAX_TOKENS=16000

# Port to bind. Set automatically by Railway/Render/Fly. Default: 8000
# PORT=8000
