{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "uvicorn railsafe.server:app --host 0.0.0.0 --port $PORT"
  },
  "env": {
    "ANTHROPIC_API_KEY": {
      "description": "Your Anthropic API key (optional; omit for demo mode)",
      "value": ""
    }
  }
}
